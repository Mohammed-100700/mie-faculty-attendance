PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/mie_faculty_attendance
JWT_SECRET=generate-a-random-64-character-string-here-use-openssl
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-frontend-url.vercel.app

# Encryption key for storing lecturer email app passwords (must be exactly 32 characters)
EMAIL_ENCRYPTION_KEY=your-exactly-32-character-key-here!!

# SendGrid API key for email sending (free tier: 100 emails/day)
# Sign up at sendgrid.com → Create API key → Add SENDER verification
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# System sender email (must be verified in SendGrid as a sender)
SYSTEM_EMAIL=noreply@yourdomain.com

NODE_ENV=production

# Admin seed secret — used to seed default data via POST /api/seed
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SEED_SECRET=change-this-to-a-random-secret
