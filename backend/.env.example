PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/mie_faculty_attendance
JWT_SECRET=generate-a-random-64-character-string-here
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-frontend-url.vercel.app
EMAIL_ENCRYPTION_KEY=your-exactly-32-character-key!!

# System email (fallback for lecturers who don't configure their own Gmail)
# Create a dedicated Gmail account for the system, enable 2FA, generate App Password
SYSTEM_EMAIL=your-system@gmail.com
SYSTEM_EMAIL_PASSWORD=your-16-char-app-password

NODE_ENV=production
